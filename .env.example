# Server configuration
PORT=3000
NODE_ENV=development

# Folder penyimpanan lokal (artikel JSON, token Blogger). Default: ./.data
# Aplikasi desktop otomatis memakai %APPDATA%\Briefzy Studio\data
BRIEFZY_DATA_DIR=

# Bind address. Desktop memakai 127.0.0.1; server dev default 0.0.0.0
BRIEFZY_HOST=

# Gemini API Key (optional server-side AI features)
GEMINI_API_KEY=

# Admin Dashboard Authentication Token
ADMIN_TOKEN=

# Google AdSense Publisher Configuration
ADSENSE_PUB_ID=pub-8492019382104928
CUSTOM_ADS_TXT=

# Google OAuth untuk Blogspot Publisher (opsional; bisa juga diisi lewat tab Blogspot Publisher di aplikasi)
# Buat OAuth client tipe "Desktop app" di Google Cloud Console dan aktifkan Blogger API v3.
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
